# Environment Configuration Example for Urban Food Environment Digital Twin (V2.1)
# Copy this file to .env and insert local non-committed secrets.

# Backend API Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Gemini API Key (Proxied through FastAPI backend, NEVER expose in Vite frontend)
GEMINI_API_KEY=your_gemini_api_key_here
